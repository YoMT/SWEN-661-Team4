{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "0.2.0-canary-20260121-a63c0dd",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.1.17",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "jest-junit": "^17.0.0",
    "msw": "^1.3.5",
    "react-test-renderer": "~19.1.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --coverage",
    "e2e": "maestro test e2e/flows/",
    "e2e:auth": "maestro test e2e/flows/auth-login.yaml",
    "e2e:all": "maestro test e2e/flows/ --format junit --output coverage/e2e-results.xml",
    "talkback": "powershell -NonInteractive -File ..\\..\\scripts\\start-talkback.ps1",
    "talkback:off": "powershell -NonInteractive -File ..\\..\\scripts\\stop-talkback.ps1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/index.ts",
      "!src/components/**",
      "!src/app/explore.tsx",
      "!src/app/index.tsx",
      "!src/app/**/_layout.tsx",
      "!src/**/*.web.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/src/__tests__/asset-mock.js",
      "\\.(css)$": "<rootDir>/src/__tests__/css-mock.js"
    },
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 70,
        "functions": 70,
        "lines": 75
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "coverage",
          "outputName": "junit.xml",
          "suiteName": "CareConnect Mobile Test Suite",
          "classNameTemplate": "{filepath}",
          "titleTemplate": "{title}",
          "ancestorSeparator": " > ",
          "addFileAttribute": "true"
        }
      ]
    ]
  }
}
