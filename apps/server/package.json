{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CareConnect API server — Express + TiDB (MySQL-compatible) backend for apps/web",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.mjs",
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "init-db": "node --env-file-if-exists=.env scripts/init-db.mjs"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.15.3"
  }
}
